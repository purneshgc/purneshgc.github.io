---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

// Pull every non-draft writeup, skip any with a bad date, newest first.
const writeups = (await getCollection("writeups", ({ data }) => !data.draft))
  .filter((w) => w.data.date instanceof Date && !isNaN(w.data.date.valueOf()))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Group by year (the list is already sorted, so groups come out newest first).
type Group = { year: number; items: typeof writeups };
const groups: Group[] = [];
for (const w of writeups) {
  const year = w.data.date.getUTCFullYear();
  const last = groups[groups.length - 1];
  if (last && last.year === year) last.items.push(w);
  else groups.push({ year, items: [w] });
}

// "19" and "Jul" — UTC so the day never shifts with the viewer's timezone.
const day = (d: Date) => String(d.getUTCDate()).padStart(2, "0");
const month = (d: Date) =>
  d.toLocaleDateString("en-US", { month: "short", timeZone: "UTC" });
---

<Layout title="Timeline" description="Chronological list of my writeups.">
  <section class="mx-auto max-w-content px-6 py-16">
    <h1 class="text-3xl font-bold tracking-tight text-ink">Timeline</h1>
    <p class="mt-2 max-w-xl text-ink-muted">
      Every writeup in order, newest first. Click one to read it.
    </p>

    <div class="mt-12 max-w-3xl">
      {groups.map((group, gi) => (
        <div>
          {/* Year heading row: hollow circle on the line */}
          <div class="grid min-h-[5rem] grid-cols-[4.5rem_1.5rem_1fr] items-center sm:grid-cols-[6rem_2rem_1fr]">
            <h2 class="text-3xl font-light text-ink-muted">{group.year}</h2>
            <div
              class:list={[
                "relative flex h-full items-center justify-center",
                "before:absolute before:bottom-0 before:left-1/2 before:w-[3px] before:-translate-x-1/2 before:bg-ink-faint/60",
                gi === 0 ? "before:top-1/2" : "before:top-0",
              ]}
            >
              <span class="relative z-10 h-4 w-4 rounded-full border-[3px] border-ink-faint bg-base-bg"></span>
            </div>
            <div></div>
          </div>

          {/* One clickable row per writeup */}
          {group.items.map((w, i) => {
            const isLastRow = gi === groups.length - 1 && i === group.items.length - 1;
            return (
              <a
                href={`/writeups/${w.slug}`}
                class:list={[
                  "group grid grid-cols-[4.5rem_1.5rem_1fr] items-center transition-colors hover:bg-base-surface2 sm:grid-cols-[6rem_2rem_1fr]",
                  i % 2 === 0 && "bg-base-surface/70",
                ]}
              >
                <time
                  class="font-mono text-sm text-ink-muted"
                  datetime={w.data.date.toISOString()}
                >
                  <span class="text-base text-ink">{day(w.data.date)}</span>
                  {" "}{month(w.data.date)}
                </time>

                <div
                  class:list={[
                    "relative flex h-full items-center justify-center",
                    "before:absolute before:left-1/2 before:top-0 before:w-[3px] before:-translate-x-1/2 before:bg-ink-faint/60",
                    isLastRow ? "before:bottom-1/2" : "before:bottom-0",
                  ]}
                >
                  <span class="relative z-10 h-3 w-3 rounded-full bg-ink-faint transition-colors group-hover:bg-accent"></span>
                </div>

                <div class="flex flex-wrap items-center gap-x-4 gap-y-2 py-3 pr-4">
                  <span class="text-base text-accent group-hover:underline underline-offset-4"> 
                    {w.data.title}
                  </span>
                </div>
              </a>
            );
          })}
        </div>
      ))}
    </div>

    {groups.length === 0 && (
      <p class="mt-10 text-ink-faint">No writeups yet.</p>
    )}
  </section>
</Layout>