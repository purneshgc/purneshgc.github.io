---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
const skills = await getCollection("skills");
const timeline = await getCollection("timeline");
const aboutEntries = await getCollection("about");
const about = aboutEntries[0];
const { Content } = about ? await about.render() : { Content: null };

const thmBadgeCount = skills.reduce((sum, s) => sum + s.data.tryhackmeBadges.length, 0);

const stats = [
  { label: "Projects", value: projects.length },
  { label: "Skills tracked", value: skills.length },
  { label: "TryHackMe badges", value: thmBadgeCount },
  { label: "Log entries", value: timeline.length },
];
---

<Layout title="Home">
  <section class="mx-auto max-w-content px-6 pb-16 pt-20 sm:pt-28">
    <p class="mb-4 font-mono text-sm text-accent">whoami</p>
    <h1 class="max-w-2xl text-4xl font-bold tracking-tight text-ink sm:text-5xl">
      YOUR NAME
    </h1>
    <p class="mt-3 max-w-xl text-lg text-ink-muted">
      Cybersecurity Enthusiast — learning by breaking things in labs, then figuring out how to defend them.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/projects" class="rounded-md bg-accent px-5 py-2.5 text-sm font-semibold text-base-bg transition-opacity hover:opacity-90">
        View Projects
      </a>
      <a href="/skills" class="rounded-md border border-base-border px-5 py-2.5 text-sm font-semibold text-ink transition-colors hover:border-accent/60 hover:text-accent">
        See Skills
      </a>
    </div>
  </section>

  <section class="border-y border-base-border/70 bg-base-surface/40">
    <div class="mx-auto grid max-w-content grid-cols-2 gap-6 px-6 py-10 sm:grid-cols-4">
      {stats.map((stat) => (
        <div>
          <p class="font-mono text-3xl font-semibold text-accent">{stat.value}</p>
          <p class="mt-1 text-sm text-ink-muted">{stat.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-content px-6 py-16">
    <h2 class="mb-6 font-mono text-sm uppercase tracking-wide text-ink-faint">About</h2>
    <div class="max-w-2xl space-y-4 text-ink-muted leading-relaxed [&_em]:text-ink-faint [&_em]:text-sm">
      {Content && <Content />}
    </div>
  </section>
</Layout>
