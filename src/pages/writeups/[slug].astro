---
import Layout from "../../layouts/Layout.astro";
import WriteupSidebar from "../../components/WriteupSidebar.astro";
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
  const writeups = await getCollection("writeups", ({ data }) => !data.draft);
  return writeups.map((writeup) => ({
    params: { slug: writeup.slug },
    props: { writeup },
  }));
}) satisfies GetStaticPaths;

const { writeup } = Astro.props;
const { title, date, platform, difficulty, tags, image,roomUrl } = writeup.data;
const { Content, headings } = await writeup.render();

// Only use "##" (depth 2) headings for the Contents sidebar, same as the
// jaxafed-style reference — "###" and deeper stay out of the TOC.
const tocHeadings = headings.filter((h) => h.depth === 2);

// Rough reading time estimate from word count (~200 wpm), same approach
// used for the stats elsewhere on the site — no extra dependency needed.
const wordCount = writeup.body.split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));

const dateLabel = date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
---

<Layout title={title}>
  <section class="mx-auto grid max-w-content gap-10 px-6 py-16 lg:grid-cols-[1fr_260px]">
    <article>
      <a href="/writeups" class="mb-6 inline-flex items-center gap-1.5 text-sm font-medium text-ink-muted hover:text-ink transition-colors">
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        All writeups
      </a>

      <h1 class="text-3xl font-bold tracking-tight text-ink">{title}</h1>

      <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-ink-faint">
        <span class="font-mono">Posted {dateLabel}</span>
        <span class="font-mono">{platform}</span>
        {difficulty && <span class="font-mono">{difficulty}</span>}
        <span class="font-mono">{readingMinutes} min read</span>
      </div>

      {tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {tags.map((tag: string) => (
            <a href={`/writeups?tag=${encodeURIComponent(tag)}`} class="rounded-full border border-base-border px-3 py-1 text-xs font-mono text-ink-muted transition-colors hover:border-accent/50 hover:text-accent">
              {tag}
            </a>
          ))}
        </div>
      )}

      {roomUrl && (
        <a
          href={roomUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex items-center gap-2 rounded-md bg-accent px-4 py-2 text-sm font-semibold text-base-bg transition-opacity hover:opacity-90"
        >
          View Room on {platform}
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg>
        </a>
      )}

      {image && (
        <img src={image} alt="" class="mt-8 w-full rounded-lg border border-base-border object-cover" />
      )}

      <div class="writeup-body mt-10 max-w-none space-y-4 leading-relaxed text-ink-muted">
        <Content />
      </div>
    </article>

    <div class="space-y-10">
      {tocHeadings.length > 0 && (
        <div>
          <h2 class="mb-4 text-sm font-semibold text-ink">Contents</h2>
          <ul id="toc" class="space-y-2 border-l border-base-border pl-4 text-sm">
            {tocHeadings.map((h) => (
              <li>
                <a href={`#${h.slug}`} data-toc-link={h.slug} class="text-ink-muted hover:text-accent transition-colors">
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
      <WriteupSidebar currentSlug={writeup.slug} />
    </div>
  </section>
</Layout>

<style>
  /* Minimal styling for markdown body content rendered via <Content /> */
  .writeup-body :global(h2) {
    @apply mt-10 scroll-mt-28 text-xl font-semibold text-ink;
  }
  .writeup-body :global(h3) {
    @apply mt-6 scroll-mt-28 text-base font-semibold text-ink;
  }
  .writeup-body :global(p) {
    @apply leading-relaxed;
  }
  .writeup-body :global(ul) {
    @apply list-disc space-y-1 pl-5;
  }
  .writeup-body :global(code) {
    @apply rounded bg-base-surface2 px-1.5 py-0.5 font-mono text-sm text-accent;
  }
  .writeup-body :global(pre) {
    @apply overflow-x-auto rounded-lg border border-base-border bg-base-surface2 p-4 text-sm;
  }
  .writeup-body :global(pre code) {
    @apply bg-transparent p-0 text-ink;
  }
  .writeup-body :global(a) {
    @apply text-accent underline underline-offset-2 hover:text-ink;
  }
  .writeup-body :global(strong) {
    @apply text-ink font-semibold;
  }
  #toc a.is-active {
    @apply text-accent;
  }
</style>

<script>
  // Highlights the Contents entry matching whichever "##" section is
  // currently in view, via IntersectionObserver.
  const headings = document.querySelectorAll<HTMLElement>(".writeup-body h2[id]");
  const links = document.querySelectorAll<HTMLAnchorElement>("#toc a[data-toc-link]");

  if (headings.length && links.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            links.forEach((link) => {
              link.classList.toggle("is-active", link.dataset.tocLink === entry.target.id);
            });
          }
        });
      },
      { rootMargin: "-20% 0px -70% 0px" }
    );
    headings.forEach((h) => observer.observe(h));
  }
</script>
