---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
  const skills = await getCollection("skills");
  const projects = await getCollection("projects");

  return skills.map((skill) => ({
    // Use skill.id as the dynamic route parameter
    params: { slug: skill.id },
    props: { skill, projects },
  }));
}) satisfies GetStaticPaths;

const { skill, projects } = Astro.props;
const { name, tryhackmeBadges, relatedProjects = [] } = skill.data;

// Use the modern top-level render() function from astro:content
const { Content } = await render(skill);

// Cross-reference relatedProjects using the entry's .id property
const linkedProjects = projects.filter((p) => relatedProjects.includes(p.id));
---
