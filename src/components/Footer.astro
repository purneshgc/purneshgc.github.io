---
const GITHUB_URL = "https://github.com/YOUR_USERNAME";
const LINKEDIN_URL = "https://linkedin.com/in/YOUR_USERNAME";
const year = new Date().getFullYear();
---

<footer class="border-t border-base-border/80 mt-24">
  <div class="mx-auto flex max-w-content flex-col items-center gap-3 px-6 py-8 text-sm text-ink-muted sm:flex-row sm:justify-between">
    <p class="font-mono">&copy; {year} YOUR NAME. Built with Astro.</p>
    <div class="flex items-center gap-4">
      <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="hover:text-ink transition-colors">GitHub</a>
      <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" class="hover:text-ink transition-colors">LinkedIn</a>
    </div>
  </div>
</footer>
