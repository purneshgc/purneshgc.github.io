---
import { socialLinks } from "../data/social";

const navItems = [
  { href: "/", label: "Home" },
  { href: "/projects", label: "Projects" },
  { href: "/skills", label: "Skills" },
  { href: "/writeups", label: "Write-ups" },
  { href: "/timeline", label: "Timeline" },
];

const currentPath = Astro.url.pathname;

// Makes /public image paths work even when the site has a base path (GitHub Pages project sites).
const withBase = (p: string) =>
  import.meta.env.BASE_URL.replace(/\/$/, "") + "/" + p.replace(/^\//, "");
---

<header class="sticky top-0 z-50 border-b border-base-border/80 bg-base-bg/90 backdrop-blur supports-[backdrop-filter]:bg-base-bg/70">
  <div class="mx-auto flex max-w-content items-center justify-between px-6 py-5">
    <a href="/" class="font-mono text-lg font-semibold tracking-tight text-ink transition-colors hover:text-accent">
      cd ~/portfolio
    </a>

    <nav class="hidden items-center gap-2 md:flex" aria-label="Main navigation">
      {navItems.map((item) => {
        const isActive = currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            aria-current={isActive ? "page" : undefined}
            class:list={[
              "rounded px-4 py-2 text-base font-medium transition-colors",
              isActive ? "text-accent" : "text-ink-muted hover:text-ink",
            ]}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <ul class="flex items-center gap-2">
      {socialLinks.map((link) => (
        <li>
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${link.name} (opens in new tab)`}
            title={link.name}
            class="flex h-11 w-11 items-center justify-center rounded-md text-ink-muted transition-colors hover:bg-base-surface2 hover:text-ink"
          >
            {link.svg && (
              <span class="flex items-center justify-center [&>svg]:h-6 [&>svg]:w-6" set:html={link.svg} />
            )}
            {link.image && (
              <img src={withBase(link.image)} alt="" class="h-6 w-6 object-contain" />
            )}
            {link.emoji && (
              <span class="text-2xl leading-none" aria-hidden="true">{link.emoji}</span>
            )}
          </a>
        </li>
      ))}
    </ul>
  </div>

  <nav class="flex items-center gap-1 overflow-x-auto border-t border-base-border/60 px-6 py-2 md:hidden" aria-label="Main navigation (mobile)">
    {navItems.map((item) => (
      <a href={item.href} class="whitespace-nowrap rounded px-3 py-2 text-base font-medium text-ink-muted hover:text-ink">
        {item.label}
      </a>
    ))}
  </nav>
</header>